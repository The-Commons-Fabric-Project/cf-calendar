# Copy to <DEPLOY_DIR>/.env on the server and fill in. Never commit the real file.

POSTGRES_USER=commons
POSTGRES_DB=commons_fabric
# Use a hex string: it is embedded in a connection URL, where characters such as
# @ : / # would need escaping. `openssl rand -hex 24` generates one.
POSTGRES_PASSWORD=

# Signs session cookies. `openssl rand -hex 32` generates one.
SESSION_SECRET=

# Host port the app is published on.
APP_PORT=3000
