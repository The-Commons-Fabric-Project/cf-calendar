# Environment files with secrets / local config
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
*.code-workspace

# Only the root lockfile is authoritative in an npm-workspaces monorepo. A lockfile
# committed inside a workspace is never read by `npm install` and only misleads
# tooling into treating that workspace as a standalone project.
package-lock.json
!/package-lock.json

# Generated lint / coverage / analysis reports, e.g. `eslint -f html -o report.html`.
coverage
eslint-report.*
*ESLINT_OUTPUT.html

# Deploy target config (see deploy/deploy.conf.example)
deploy/deploy.conf
.playwright-mcp