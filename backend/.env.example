PORT=3000 # Port the Express server listens on
# Environment mode: development | production
NODE_ENV=development

# Allowed CORS origin when NODE_ENV=development.
# Set to a specific origin (e.g. http://localhost:5173), or "network" to allow
# any local device on any port. Ignored when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign session cookies (see src/utils/userSessions.ts). Generate
# a random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Paste in the line below, after the equal sign, WITHOUT ANY QUOTES.
SESSION_SECRET=

# Above line should look like:
# SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://dev:dev@localhost:5432/appdb"
