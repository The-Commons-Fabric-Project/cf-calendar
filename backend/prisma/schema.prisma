// Prisma translation of src/docs/db/schema.dbml, the conceptual source of truth.
// Differences from the DBML:
//   - ids are Int (serial) rather than bigint, so they serialize as JSON numbers.
//   - org_tags is text constrained by a CHECK, not a Postgres enum, so adding a
//     tag stays a CHECK change; src/utils/orgTags.ts mirrors the list.
//   - CHECK constraints cannot be expressed here; they live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int          @id @default(autoincrement())
  fullname       String
  email          String       @unique
  passwordHash   String       @map("password_hash") // argon2id PHC string - the salt and params are encoded in it
  organizationId Int          @map("organization_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id])
  events         Event[]

  @@map("users")
}

model Event {
  id               Int      @id @default(autoincrement())
  uid              String   @unique @default(uuid(4)) @db.Uuid // iCalendar UID - random per RFC 7986, never derived from id or host
  title            String
  ownerId          Int      @map("owner_id")
  startsAt         DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime @map("ends_at") @db.Timestamptz(3)
  location         String?
  description      String?
  thumbnail        String? // file path of image e.g. ./public/event_images/example.jpg
  registrationLink String?  @map("registration_link")
  volunteerContact String?  @map("volunteer_contact")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner            User     @relation(fields: [ownerId], references: [id])

  @@map("events")
}

model Organization {
  id      Int                @id @default(autoincrement())
  name    String
  logo    String? // file path of image e.g. ./public/organization_logos/example.jpg
  blurb   String? // short description of the organization
  contact String?
  website String?

  users   User[]
  tags    OrganizationTag[]

  @@map("organizations")
}

model OrganizationTag {
  organizationId Int          @map("organization_id")
  tag            String

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, tag])
  @@map("organizations_tags")
}

