# Read by docker-compose.yml. Copy to .env; .env is gitignored, never commit secrets.
# Every value is optional except SESSION_SECRET, which the `app` profile needs.

POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=appdb
POSTGRES_PORT=5432

APP_PORT=3000

# Signs session cookies for the containerized app. Generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=
